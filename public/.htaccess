# ----------------------------------------------------------------------
# Crunchy Bag - Apache / LiteSpeed Canonical 301 Redirects & Header Rules
# ----------------------------------------------------------------------

# Force UTF-8 Character Encoding in HTTP Header
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Permanent 301 Canonical Redirect: www to non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3. SPA Fallback (route non-file/directory requests to index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
